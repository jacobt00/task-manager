<section class="auth-wrap"><div class="auth-card"><span class="eyebrow">ADMIN / USERS</span><h1>Create user</h1>{{#if error}}<div class="alert" role="alert">{{error}}</div>{{/if}}<form method="post" action="/admin/users"><input type="hidden" name="_csrf" value="{{csrfToken}}"><label>Name<input name="name" maxlength="100" value="{{name}}" required></label><label>Email<input name="email" type="email" value="{{email}}" required></label><label>Temporary password<input name="password" type="password" minlength="12" autocomplete="new-password" required></label><label>Role<select name="role" required><option value="receiver">Receiver</option><option value="admin">Admin (Sender)</option></select></label><button class="btn primary" type="submit">Create account</button></form></div></section>