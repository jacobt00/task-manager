<section class="container section"><span class="eyebrow">ADMIN / SENDER</span><h1>{{#if edit}}Edit task{{else}}Create task{{/if}}</h1><p>Manage task details, receiver and deadline. Status changes use the separate transition controls.</p><div class="card task-form-card">{{#if error}}<div class="alert" role="alert">{{error}}</div>{{/if}}<form method="post" action="{{#if edit}}/admin/tasks/{{task._id}}/edit{{else}}/admin/tasks{{/if}}" class="task-form"><input type="hidden" name="_csrf" value="{{csrfToken}}"><label>Title<input name="title" maxlength="150" required value="{{task.title}}"></label><label>Description<textarea name="description" maxlength="5000" required rows="5">{{task.description}}</textarea></label><div class="task-form-grid"><label>Deadline (UTC calendar date)<input type="date" name="deadline" value="{{task.deadline}}" required></label><label>Assigned receiver<select name="assignedReceiver" required><option value="">Select a receiver</option>{{#each receivers}}<option value="{{_id}}" {{#if selected}}selected{{/if}}>{{name}} ({{email}})</option>{{/each}}</select></label></div>{{#if edit}}<p class="muted">Current status: <strong>{{statusLabel}}</strong>. Reassigning an active task resets its status to To do. Terminal tasks cannot be reassigned.</p>{{else}}<p class="muted">Initial status: <strong>To do</strong>.</p>{{/if}}<div class="task-actions"><button class="btn primary" type="submit">{{#if edit}}Save changes{{else}}Create task{{/if}}</button><a class="btn secondary" href="/admin/tasks">Back</a></div></form></div></section>
