<section class="container section"><div class="task-heading"><div><span class="eyebrow">ADMIN / SENDER</span><h1>All tasks</h1><p>View assignments, deadlines and progress.</p></div><a class="btn primary" href="/admin/tasks/new">+ Create task</a></div>{{#if hasTasks}}<div class="task-table-wrap"><table class="task-table"><thead><tr><th>Task</th><th>Receiver</th><th>Deadline</th><th>Status</th><th>Actions</th></tr></thead><tbody>{{#each tasks}}<tr><td><strong>{{title}}</strong><div class="task-description">{{description}}</div></td><td>{{#if assignedReceiver}}{{assignedReceiver.name}}<small>{{assignedReceiver.email}}</small>{{else}}Receiver unavailable{{/if}}</td><td>{{deadlineDisplay}}</td><td><span class="task-status status-{{statusClass}}">{{statusLabel}}</span></td><td><a class="text-link" href="/admin/tasks/{{_id}}/edit">Edit</a>{{#if canCancel}}<form method="post" action="/admin/tasks/{{_id}}/cancel" class="inline-form"><input type="hidden" name="_csrf" value="{{@root.csrfToken}}"><button type="submit" class="nav-button">Cancel task</button></form>{{/if}}<form method="post" action="/admin/tasks/{{_id}}/status" class="inline-form"><input type="hidden" name="_csrf" value="{{@root.csrfToken}}">{{#if canStart}}<button class="nav-button" name="status" value="ongoing">Start</button>{{/if}}{{#if canFinish}}<button class="nav-button" name="status" value="done">Complete</button>{{/if}}{{#if canFail}}<button class="nav-button" name="status" value="failed">Mark failed</button>{{/if}}</form></td></tr>{{/each}}</tbody></table></div>{{else}}<div class="card task-empty"><h3>No tasks yet</h3><a class="btn primary" href="/admin/tasks/new">Create task</a></div>{{/if}}</section>
