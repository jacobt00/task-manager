<section class="auth-wrap"><div class="auth-card"><span class="eyebrow">WELCOME BACK</span><h1>Log in</h1><p>Access your TaskFlow workspace.</p>{{#if error}}<div class="alert" role="alert">{{error}}</div>{{/if}}<form action="/login" method="post"><input type="hidden" name="_csrf" value="{{csrfToken}}"><label>Email<input name="email" type="email" autocomplete="email" value="{{email}}" required></label><label>Password<input name="password" type="password" autocomplete="current-password" required></label><button class="btn primary" type="submit">Log in</button></form><p>New here? <a class="text-link" href="/register">Create an account</a></p></div></section>