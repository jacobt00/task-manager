<section class="auth-wrap"><div class="auth-card"><span class="eyebrow">GET STARTED</span><h1>Create an account</h1><p>All new accounts start as Receivers.</p>{{#if error}}<div class="alert" role="alert">{{error}}</div>{{/if}}<form action="/register" method="post"><input type="hidden" name="_csrf" value="{{csrfToken}}"><label>Full name<input name="name" maxlength="100" autocomplete="name" value="{{name}}" required></label><label>Email<input name="email" type="email" autocomplete="email" value="{{email}}" required></label><label>Password<input name="password" type="password" minlength="12" autocomplete="new-password" required><small>At least 12 characters.</small></label><button class="btn primary" type="submit">Register</button></form><p>Already registered? <a class="text-link" href="/login">Log in</a></p></div></section>