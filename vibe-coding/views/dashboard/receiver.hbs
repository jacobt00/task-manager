<section class="container section"><span class="eyebrow">RECEIVER</span><h1>Welcome, {{currentUser.name}}</h1><p>Your assigned tasks.</p>{{#each tasks}}<div class="card" style="margin-bottom:1rem"><h3>{{title}}</h3><p>{{description}}</p><p class="muted">Deadline: {{deadlineDisplay}} · Status: <strong>{{status}}</strong></p>{{#if canStart}}<form class="inline-form" method="post" action="/receiver/tasks/{{_id}}/status"><input type="hidden" name="_csrf" value="{{@root.csrfToken}}"><button class="btn primary" name="status" value="ongoing">Start task</button></form>{{/if}}{{#if canFinish}}<form class="inline-form" method="post" action="/receiver/tasks/{{_id}}/status"><input type="hidden" name="_csrf" value="{{@root.csrfToken}}"><button class="btn primary" name="status" value="done">Complete task</button></form>{{/if}}{{#if canFail}}<form class="inline-form" method="post" action="/receiver/tasks/{{_id}}/status"><input type="hidden" name="_csrf" value="{{@root.csrfToken}}"><button class="btn secondary" name="status" value="failed">Mark failed</button></form>{{/if}}{{#if canCancel}}<form class="inline-form" method="post" action="/receiver/tasks/{{_id}}/cancel"><input type="hidden" name="_csrf" value="{{@root.csrfToken}}"><button class="btn secondary" type="submit">Cancel task</button></form>{{/if}}</div>{{else}}<div class="card"><p>No tasks assigned yet.</p></div>{{/each}}</section>
